{
  "name": "jevbrowserext",
  "version": "1.3.1",
  "description": "Chrome extension that drives web pages with TypeSafe Jev, a decision model that picks the next click, keystroke or dropdown value in a few hundred milliseconds. MV3 port of browser-use/jev-ultrafast.",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build",
    "e2e:ext": "npm run build && tsx scripts/e2e-extension.ts"
  },
  "keywords": [
    "browser-agent",
    "web-agent",
    "browser-automation",
    "chrome-extension",
    "manifest-v3",
    "typesafe",
    "jev",
    "openrouter",
    "cloudflare-workers-ai",
    "browser-use",
    "ai-agent",
    "dom-automation",
    "typescript",
    "react",
    "vite"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chy4pro/JevBrowserExt.git"
  },
  "homepage": "https://github.com/chy4pro/JevBrowserExt#readme"
}
